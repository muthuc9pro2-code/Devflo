APP_NAME=Devflo
APP_VERSION=1.0.0

DATABASE_URL=mysql+pymysql://user:password@db-host:3306/devflo

REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND_URL=redis://redis:6379/1
REDIS_EVENTS_URL=redis://redis:6379/0

# Generate a production value with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Local development may use loopback HTTP with insecure cookies.
# Any non-local FRONTEND_URL must be HTTPS with COOKIE_SECURE=true;
# the API fails startup validation otherwise.
FRONTEND_URL=http://localhost
COOKIE_SECURE=false

# Optional. Leave blank for deterministic-only analysis.
GEMINI_API_KEY=
GEMINI_MODEL=your-exact-working-model-id

RESEND_API_KEY=replace-me
EMAIL_FROM=no-reply@example.com
