:80 {
    handle /auth/* {
        request_body {
            max_size 16KB
        }
        reverse_proxy api:8000
    }

    handle /analysis/* {
        reverse_proxy api:8000
    }

    handle /analyses/* {
        reverse_proxy api:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
